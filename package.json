{
    "name": "@aegisshare/frontend",
    "private": true,
    "version": "4.2.1",
    "type": "module",
    "description": "Zero-knowledge, compliance-first secure file-sharing platform frontend",
    "scripts": {
        "dev": "vite",
        "dev:debug": "vite --debug",
        "build": "tsc && vite build",
        "build:analyze": "vite build --mode analyze",
        "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
        "type-check": "tsc --noEmit",
        "type-check:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "clean": "rm -rf dist .tsbuildinfo || (rmdir /s /q dist 2>nul & del .tsbuildinfo 2>nul & exit 0)",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext ts,tsx --fix --report-unused-disable-directives",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "coverage": "vitest --coverage"
    },
    "dependencies": {
        "@tanstack/react-virtual": "^3.13.23",
        "@types/dompurify": "^3.0.5",
        "argon2-browser": "^1.18.0",
        "axios": "^1.6.0",
        "dompurify": "^3.3.3",
        "framer-motion": "^12.38.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-focus-lock": "^2.13.7",
        "react-helmet-async": "^3.0.0",
        "react-router-dom": "^6.22.0",
        "tweetnacl": "^1.0.3",
        "zustand": "^4.5.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.1.5",
        "@testing-library/react": "^14.1.2",
        "@testing-library/user-event": "^14.5.1",
        "@types/react": "^18.2.46",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vitejs/plugin-react-oxc": "^1.3.0",
        "@vitest/ui": "^4.1.2",
        "autoprefixer": "^10.4.17",
        "eslint": "^8.56.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "jsdom": "^29.0.2",
        "msw": "^2.2.0",
        "postcss": "^8.4.33",
        "tailwindcss": "^3.4.1",
        "terser": "^5.46.1",
        "typescript": "^5.4.0",
        "vite": "^8.0.5",
        "vite-plugin-compression": "^0.5.1",
        "vite-plugin-visualizer": "^0.10.0",
        "vitest": "^4.1.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}